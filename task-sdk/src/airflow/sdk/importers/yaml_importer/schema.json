{
  "$defs": {
    "ConstRef": {
      "additionalProperties": false,
      "description": "Force a literal; the value is taken verbatim.",
      "properties": {
        "$const": {
          "title": "$Const"
        }
      },
      "required": [
        "$const"
      ],
      "title": "ConstRef",
      "type": "object"
    },
    "Literal": {
      "description": "A literal value.",
      "not": {
        "not": {
          "patternProperties": {
            "^\\$": false
          }
        },
        "type": "object"
      },
      "oneOf": [
        {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/XComRef"
              },
              {
                "$ref": "#/$defs/TemplateRef"
              },
              {
                "$ref": "#/$defs/ConstRef"
              },
              {
                "$ref": "#/$defs/Literal"
              }
            ]
          },
          "type": "object"
        },
        {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/XComRef"
              },
              {
                "$ref": "#/$defs/TemplateRef"
              },
              {
                "$ref": "#/$defs/ConstRef"
              },
              {
                "$ref": "#/$defs/Literal"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Literal"
    },
    "Task": {
      "additionalProperties": true,
      "description": "A ready-made operator (uses) or task with custom code (run).",
      "not": {
        "allOf": [
          {
            "properties": {
              "uses": {
                "type": "string"
              }
            },
            "required": [
              "uses"
            ]
          },
          {
            "properties": {
              "run": {
                "type": "object"
              }
            },
            "required": [
              "run"
            ]
          }
        ]
      },
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "needs": {
          "items": {
            "type": "string"
          },
          "title": "Needs",
          "type": "array"
        },
        "extends": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "with": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/XComRef"
              },
              {
                "$ref": "#/$defs/TemplateRef"
              },
              {
                "$ref": "#/$defs/ConstRef"
              },
              {
                "$ref": "#/$defs/Literal"
              }
            ]
          },
          "title": "With",
          "type": "object"
        },
        "uses": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/XComRef"
              },
              {
                "$ref": "#/$defs/TemplateRef"
              },
              {
                "$ref": "#/$defs/ConstRef"
              },
              {
                "$ref": "#/$defs/Literal"
              }
            ]
          },
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "title": "Task",
      "type": "object"
    },
    "TaskTemplate": {
      "additionalProperties": true,
      "description": "A reusable, partial task fragment merged into any task that extends it.\n\nThis holds arbitrary keys as-is. All validation is done on the merged task.",
      "properties": {},
      "title": "TaskTemplate",
      "type": "object"
    },
    "TemplateRef": {
      "additionalProperties": false,
      "description": "A Jinja template.",
      "oneOf": [
        {
          "required": [
            "$t"
          ]
        },
        {
          "required": [
            "$template"
          ]
        }
      ],
      "properties": {
        "$t": {
          "title": "$T",
          "type": "string"
        },
        "$template": {
          "title": "$T",
          "type": "string"
        }
      },
      "title": "TemplateRef",
      "type": "object"
    },
    "TimetableSchedule": {
      "additionalProperties": false,
      "description": "A constructed timetable.",
      "properties": {
        "uses": {
          "minLength": 1,
          "title": "Uses",
          "type": "string"
        },
        "with": {
          "additionalProperties": true,
          "title": "With",
          "type": "object"
        }
      },
      "required": [
        "uses"
      ],
      "title": "TimetableSchedule",
      "type": "object"
    },
    "XComRef": {
      "additionalProperties": false,
      "description": "An upstream task's XCom output.",
      "oneOf": [
        {
          "required": [
            "$x"
          ]
        },
        {
          "required": [
            "$xcom"
          ]
        }
      ],
      "properties": {
        "$x": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/XComTarget"
            }
          ],
          "title": "$X"
        },
        "$xcom": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/XComTarget"
            }
          ],
          "title": "$X"
        }
      },
      "title": "XComRef",
      "type": "object"
    },
    "XComTarget": {
      "additionalProperties": false,
      "description": "The object form of an XCom reference.",
      "properties": {
        "task": {
          "title": "Task",
          "type": "string"
        },
        "key": {
          "default": null,
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Key"
        }
      },
      "required": [
        "task"
      ],
      "title": "XComTarget",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A Dag represented by one YAML document.\n\nExtra top-level keys are Dag-level arguments.",
  "properties": {
    "$schema": {
      "title": "$Schema",
      "type": "string"
    },
    "dag_id": {
      "minLength": 1,
      "title": "Dag Id",
      "type": "string"
    },
    "schedule": {
      "default": null,
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/TimetableSchedule"
        },
        {
          "type": "null"
        }
      ],
      "title": "Schedule"
    },
    "templates": {
      "additionalProperties": {
        "$ref": "#/$defs/TaskTemplate"
      },
      "title": "Templates",
      "type": "object"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "dag_id"
  ],
  "title": "Airflow YAML Dag (2026-10-30)",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
