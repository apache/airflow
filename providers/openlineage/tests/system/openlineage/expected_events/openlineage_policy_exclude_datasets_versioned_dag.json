[
    {
        "eventType": "START",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag",
            "facets": {
                "airflow": {
                    "tasks": {
                        "t_skipped_emit_off": {
                            "emits_ol_events": "{{ result == false }}"
                        },
                        "t_skipped_full_info": {
                            "emits_ol_events": "{{ result == true }}"
                        },
                        "t_runtime_outlets": {
                            "emits_ol_events": "{{ result == true }}"
                        },
                        "t_collector_cap": {
                            "emits_ol_events": "{{ result == true }}"
                        },
                        "t_skipped": {
                            "emits_ol_events": "{{ result == true }}"
                        },
                        "check_events": {
                            "emits_ol_events": "{{ result == true }}"
                        }
                    }
                }
            }
        }
    },
    {
        "eventType": "START",
        "inputs": [
            {
                "namespace": "file://host1",
                "name": "/keep_declared_in.txt"
            }
        ],
        "outputs": [
            {
                "namespace": "file://host1",
                "name": "/keep_declared_out.txt"
            }
        ],
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_runtime_outlets"
        }
    },
    {
        "eventType": "COMPLETE",
        "inputs": [
            {
                "namespace": "file://host1",
                "name": "/keep_declared_in.txt"
            }
        ],
        "outputs": [
            {
                "namespace": "file://host1",
                "name": "/keep_declared_out.txt"
            }
        ],
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_runtime_outlets"
        }
    },
    {
        "eventType": "START",
        "inputs": [],
        "outputs": [],
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_collector_cap"
        }
    },
    {
        "eventType": "COMPLETE",
        "inputs": "{{ result | length == 65 and result[0].name == '/cap_keep_06_in.txt' and (result | last).name == '/cap_keep_70_in.txt' }}",
        "outputs": "{{ result | length == 65 and result[0].name == '/cap_keep_06_out.txt' and (result | last).name == '/cap_keep_70_out.txt' }}",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_collector_cap"
        }
    },
    {
        "eventType": "COMPLETE",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_skipped"
        },
        "$absent": "Airflow 3.0 calls no listener when a task skips itself"
    },
    {
        "$absent": "the task was skipped",
        "eventType": "FAIL",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_skipped"
        }
    },
    {
        "$absent": "conf emit false on a skipped task",
        "eventType": "START",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_skipped_emit_off"
        }
    },
    {
        "$absent": "conf emit false on a skipped task",
        "eventType": "COMPLETE",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_skipped_emit_off"
        }
    },
    {
        "$absent": "conf emit false on a skipped task",
        "eventType": "FAIL",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_skipped_emit_off"
        }
    },
    {
        "eventType": "COMPLETE",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_skipped_full_info"
        },
        "$absent": "Airflow 3.0 calls no listener when a task skips itself"
    },
    {
        "eventType": "FAIL",
        "job": {
            "name": "openlineage_policy_exclude_datasets_versioned_dag.t_skipped_full_info"
        },
        "$absent": "the task was skipped"
    }
]
