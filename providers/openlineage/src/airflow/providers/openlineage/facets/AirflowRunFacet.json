{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AirflowRunFacet": {
      "allOf": [
        {
          "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/RunFacet"
        },
        {
          "type": "object",
          "properties": {
            "dag": {
              "$ref": "#/$defs/DAG"
            },
            "dagRun": {
              "$ref": "#/$defs/DagRun"
            },
            "taskInstance": {
              "$ref": "#/$defs/TaskInstance"
            },
            "task": {
              "$ref": "#/$defs/Task"
            },
            "taskUuid": {
              "type": "string"
            }
          },
          "required": [
            "dag",
            "dagRun",
            "taskInstance",
            "task",
            "taskUuid"
          ]
        }
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "depends_on_past": {
          "type": "boolean"
        },
        "downstream_task_ids": {
          "type": "string"
        },
        "execution_timeout": {
          "type": "string"
        },
        "executor_config": {
          "type": "object",
          "additionalProperties": true
        },
        "ignore_first_depends_on_past": {
          "type": "boolean"
        },
        "is_setup": {
          "type": "boolean"
        },
        "is_teardown": {
          "type": "boolean"
        },
        "mapped": {
          "type": "boolean"
        },
        "max_active_tis_per_dag": {
          "type": "integer"
        },
        "max_active_tis_per_dagrun": {
          "type": "integer"
        },
        "max_retry_delay": {
          "type": "string"
        },
        "multiple_outputs": {
          "type": "boolean"
        },
        "operator_class": {
          "description": "Module + class name of the operator",
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "priority_weight": {
          "type": "integer"
        },
        "queue": {
          "type": "string"
        },
        "retries": {
          "type": "integer"
        },
        "retry_exponential_backoff": {
          "type": "boolean"
        },
        "run_as_user": {
          "type": "string"
        },
        "sla": {
          "type": "number"
        },
        "task_id": {
          "type": "string"
        },
        "trigger_rule": {
          "type": "string"
        },
        "upstream_task_ids": {
          "type": "string"
        },
        "wait_for_downstream": {
          "type": "boolean"
        },
        "wait_for_past_depends_before_skipping": {
          "type": "boolean"
        },
        "weight_rule": {
          "type": "string"
        },
        "task_group": {
          "description": "Task group related information",
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "downstream_group_ids": {
              "type": "string"
            },
            "downstream_task_ids": {
              "type": "string"
            },
            "prefix_group_id": {
              "type": "boolean"
            },
            "tooltip": {
              "type": "string"
            },
            "upstream_group_ids": {
              "type": "string"
            },
            "upstream_task_ids": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": ["group_id"]
        }
      },
      "additionalProperties": true,
      "required": [
        "task_id"
      ]
    },
    "DAG": {
      "type": "object",
      "properties": {
        "dag_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "schedule_interval": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "string"
        },
        "timetable": {
          "description": "Describes timetable (successor of schedule_interval)",
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "dag_id",
        "start_date"
      ]
    },
    "TaskInstance": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number"
        },
        "id": {
          "description": "UUID of this attempt (Airflow 3+). Every try, and every task instance a clear creates again, gets a new one.",
          "type": "string",
          "format": "uuid"
        },
        "map_index": {
          "description": "Position in a mapped task's expansion. Absent for a task that isn't mapped.",
          "type": "integer"
        },
        "loop_index": {
          "description": "Zero-based iteration of the innermost loop the task runs in (Airflow 3.4+). Absent outside a loop.",
          "type": "integer"
        },
        "loop_max_iterations": {
          "description": "Maximum number of iterations of the innermost loop the task runs in (Airflow 3.4+). Absent outside a loop.",
          "type": "integer"
        },
        "loop_group_id": {
          "description": "Group id of the innermost loop the task runs in (Airflow 3.4+), which loop_index counts the iterations of. Absent outside a loop.",
          "type": "string"
        },
        "loop_decision": {
          "description": "Decision of a loop gate (Airflow 3.4+), on its COMPLETE or FAIL event only. A FAIL with stop false at the last iteration means the loop's until was still false at max_iterations.",
          "type": "object",
          "properties": {
            "stop": {
              "description": "Whether the gate stopped the loop.",
              "type": "boolean"
            },
            "reason": {
              "description": "Reason given by until, if any.",
              "type": "string"
            }
          }
        },
        "region_id": {
          "description": "Id of the region (one execution of a loop or of a mapped task's expansion) the task instance belongs to (Airflow 3.4+). Shared by the task instances of that region. Clearing a loop forks its region, so a re-run of an iteration gets a new region_id. Region ids are UUIDv7, so a later trajectory has a greater one, which is an implementation detail. Absent for a task that is neither mapped nor in a loop.",
          "type": "string",
          "format": "uuid"
        },
        "region_index": {
          "description": "Position inside the region (Airflow 3.4+): the iteration for a task in a loop that isn't mapped, the map index for a mapped task. Together with dag_id, the Dag run's run_id, task_id, region_id and try_number it identifies one attempt. Absent with region_id.",
          "type": "integer"
        },
        "pool": {
          "type": "string"
        },
        "try_number": {
          "description": "Try of the task instance, counted per region_id and region_index.",
          "type": "integer"
        },
        "max_tries": {
          "description": "Last try_number that is retried on failure, so a failed try with try_number > max_tries is final. Equals the task's retries until the task instance is cleared, which sets it to the last try_number plus retries.",
          "type": "integer"
        },
        "queued_dttm": {
          "type": "string",
          "format": "date-time"
        },
        "log_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true,
      "required": [
        "pool",
        "try_number"
      ]
    },
    "DagRun": {
      "type": "object",
      "properties": {
        "conf": {
          "type": "object",
          "additionalProperties": true
        },
        "dag_id": {
          "type": "string"
        },
        "data_interval_start": {
          "type": "string",
          "format": "date-time"
        },
        "data_interval_end": {
          "type": "string",
          "format": "date-time"
        },
        "external_trigger": {
          "type": "boolean"
        },
        "run_id": {
          "type": "string"
        },
        "run_type": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "required": [
        "dag_id",
        "run_id"
      ]
    }
  },
  "type": "object",
  "properties": {
    "airflow": {
      "$ref": "#/$defs/AirflowRunFacet"
    }
  }
}
