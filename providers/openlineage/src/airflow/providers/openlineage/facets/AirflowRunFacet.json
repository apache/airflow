{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AirflowRunFacet": {
      "allOf": [
        {
          "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/RunFacet"
        },
        {
          "type": "object",
          "properties": {
            "dag": {
              "$ref": "#/$defs/DAG"
            },
            "dagRun": {
              "$ref": "#/$defs/DagRun"
            },
            "taskInstance": {
              "$ref": "#/$defs/TaskInstance"
            },
            "task": {
              "$ref": "#/$defs/Task"
            },
            "taskUuid": {
              "type": "string"
            }
          },
          "required": [
            "dag",
            "dagRun",
            "taskInstance",
            "task",
            "taskUuid"
          ]
        }
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "depends_on_past": {
          "type": "boolean"
        },
        "downstream_task_ids": {
          "type": "string"
        },
        "execution_timeout": {
          "type": "string"
        },
        "executor_config": {
          "type": "object",
          "additionalProperties": true
        },
        "ignore_first_depends_on_past": {
          "type": "boolean"
        },
        "is_setup": {
          "type": "boolean"
        },
        "is_teardown": {
          "type": "boolean"
        },
        "mapped": {
          "type": "boolean"
        },
        "max_active_tis_per_dag": {
          "type": "integer"
        },
        "max_active_tis_per_dagrun": {
          "type": "integer"
        },
        "max_retry_delay": {
          "type": "string"
        },
        "multiple_outputs": {
          "type": "boolean"
        },
        "operator_class": {
          "description": "Module + class name of the operator",
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "priority_weight": {
          "type": "integer"
        },
        "queue": {
          "type": "string"
        },
        "retries": {
          "type": "integer"
        },
        "retry_delay": {
          "type": "string"
        },
        "retry_exponential_backoff": {
          "type": "boolean"
        },
        "run_as_user": {
          "type": "string"
        },
        "sla": {
          "type": "number"
        },
        "task_id": {
          "type": "string"
        },
        "trigger_rule": {
          "type": "string"
        },
        "upstream_task_ids": {
          "type": "string"
        },
        "wait_for_downstream": {
          "type": "boolean"
        },
        "wait_for_past_depends_before_skipping": {
          "type": "boolean"
        },
        "weight_rule": {
          "type": "string"
        },
        "task_group": {
          "description": "Task group related information",
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "unique_group_id": {
              "description": "Id that identifies the group in the Dag, as the job facet names it.",
              "type": "string"
            },
            "downstream_group_ids": {
              "type": "string"
            },
            "downstream_task_ids": {
              "type": "string"
            },
            "prefix_group_id": {
              "type": "boolean"
            },
            "tooltip": {
              "type": "string"
            },
            "upstream_group_ids": {
              "type": "string"
            },
            "upstream_task_ids": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": ["group_id"]
        },
        "loop": {
          "description": "The loop the task runs in (Airflow 3.4+).",
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "max_iterations": {
              "type": "integer"
            },
            "has_until": {
              "type": "boolean"
            },
            "gate_task_id": {
              "type": "string"
            },
            "terminal_task_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "task_id"
      ]
    },
    "DAG": {
      "type": "object",
      "properties": {
        "dag_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "schedule_interval": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "string"
        },
        "timetable": {
          "description": "Describes timetable (successor of schedule_interval)",
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "dag_id",
        "start_date"
      ]
    },
    "TaskInstance": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number"
        },
        "map_index": {
          "type": "integer"
        },
        "id": {
          "description": "Id of the task instance attempt (Airflow 3+). Absent from the FAIL events the scheduler sends itself before Airflow 3.4, when the task instance already holds its next attempt's id.",
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "max_tries": {
          "type": "integer"
        },
        "rendered_map_index": {
          "type": "string"
        },
        "expanded_ti_count": {
          "description": "Number of instances, removed ones excluded, in the mapped task's expansion, of this loop iteration in a loop (Airflow 3.4+). Absent from the events the scheduler sends itself.",
          "type": "integer"
        },
        "region_id": {
          "description": "Region the task instance is stored in (Airflow 3.4+): the mapped task's expansion, in a loop or not, and otherwise the loop's region, as `loop.region_id`.",
          "type": "string"
        },
        "region_index": {
          "description": "Position of the task instance in its region (Airflow 3.4+): the map index, from 0, of a mapped task, and otherwise the loop iteration, from 1, as `loop.index`. With `region_id`, the coordinates Airflow's REST API and UI select the task instance by.",
          "type": "integer"
        },
        "dag_version_id": {
          "type": "string"
        },
        "dag_bundle_name": {
          "type": "string"
        },
        "dag_bundle_version": {
          "type": "string"
        },
        "loop": {
          "description": "The loop iteration of the task instance (Airflow 3.4+). The events the scheduler sends itself have at most `index`, for a task that isn't mapped.",
          "type": "object",
          "properties": {
            "index": {
              "description": "The iteration, from 1.",
              "type": "integer"
            },
            "region_id": {
              "description": "Region of the loop's run, shared by all its iterations; after a clear, the region of the rerun.",
              "type": "string"
            },
            "trajectory": {
              "description": "1 for the loop's first run, n + 1 for its n-th rerun after a clear.",
              "type": "integer"
            },
            "forked_from_region_id": {
              "description": "Region of the run a rerun after a clear was forked from.",
              "type": "string"
            },
            "resumes_from_index": {
              "description": "Iteration a rerun after a clear resumes from.",
              "type": "integer"
            },
            "decision": {
              "description": "Whether a loop gate stops the loop, once it decided.",
              "type": "object",
              "properties": {
                "stop": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": true
        },
        "pool": {
          "type": "string"
        },
        "try_number": {
          "type": "integer"
        },
        "queued_dttm": {
          "type": "string",
          "format": "date-time"
        },
        "log_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true,
      "required": [
        "pool",
        "try_number"
      ]
    },
    "DagRun": {
      "type": "object",
      "properties": {
        "conf": {
          "type": "object",
          "additionalProperties": true
        },
        "dag_id": {
          "type": "string"
        },
        "data_interval_start": {
          "type": "string",
          "format": "date-time"
        },
        "data_interval_end": {
          "type": "string",
          "format": "date-time"
        },
        "external_trigger": {
          "type": "boolean"
        },
        "run_id": {
          "type": "string"
        },
        "run_type": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "required": [
        "dag_id",
        "run_id"
      ]
    }
  },
  "type": "object",
  "properties": {
    "airflow": {
      "$ref": "#/$defs/AirflowRunFacet"
    }
  }
}
