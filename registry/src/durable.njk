---
permalink: /durable/index.html
eleventyExcludeFromCollections: true
---
{%- set base = '/operators/' | url -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Redirecting to Operators</title>
  <script>
    // On the old page, capability=all meant durable or deferrable, and every type was shown.
    (function() {
      const params = new URLSearchParams(window.location.search);
      if (!params.get('capability') || params.get('capability') === 'all') {
        params.set('capability', 'durable-or-deferrable');
      }
      if (!params.get('type')) params.set('type', 'all');
      window.location.replace('{{ base }}?' + params.toString() + window.location.hash);
    })();
  </script>
  <meta http-equiv="refresh" content="0; url={{ base }}?capability=durable-or-deferrable&type=all">
  <link rel="canonical" href="https://airflow.apache.org/registry/operators/">
</head>
<body>
  <p>This page moved to <a href="{{ base }}?capability=durable-or-deferrable&type=all">Operators</a>.</p>
</body>
</html>
